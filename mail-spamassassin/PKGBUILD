  "systemd-tmpfile.conf"
)
sha256sums=('c521be978cef3d49b1e139477ca60a0bd498345fc98274796e44161fae49a17f'
  'db9cc39fad18e9ac4a9ed9443587bdf29a0ac9f6c8dbcb5a0b658e9f7c38d211')

build() {
  cd "${srcdir}/Mail-SpamAssassin-${pkgver}"

  _cc_flag=""
  _perl_inc="-I /opt/zextras/common/lib/perl5"
  if [ -n "${CROSS_COMPILE}" ]; then
    export CC="${CROSS_COMPILE}gcc"
    export LD="${CROSS_COMPILE}gcc"
    _cc_flag="CC=${CROSS_COMPILE}gcc LD=${CROSS_COMPILE}gcc"
    export ac_cv_func_malloc_0_nonnull=yes
    export ac_cv_func_realloc_0_nonnull=yes
    # Add target arch dir to PERL5LIB so cross-compiled deps are visible.
    _perl_inc="-I /opt/zextras/common/lib/perl5/aarch64-linux-gnu-thread-multi ${_perl_inc}"
  fi

  # Align SpamAssassin's compiled rule/state dirs with Carbonio's layout so the
  # engine reads the ruleset that carbonio-spamassassin-rules installs and so
  # runtime sa-update writes to a discoverable location. Without these, SA
  # defaults to DEF_RULES_DIR=$PREFIX/share/spamassassin and
  # LOCAL_STATE_DIR=/var/opt/spamassassin, neither of which matches
  # /opt/zextras/data/spamassassin/rules -> "no rules were found" (CO-3849).
  #   DATADIR       -> DEF_RULES_DIR  (default rules dir; stock + sa-update'd .cf)
  #   CONFDIR       -> LOCAL_RULES_DIR (.pre plugin config + local.cf; gpg keydir)
  #   LOCALSTATEDIR -> LOCAL_STATE_DIR (runtime sa-update <ver>/updates_spamassassin_org)
  # NB: the input macro is LOCALSTATEDIR, not LOCAL_STATE_DIR — the latter is
  # ignored by Makefile.PL, which then defaults to /var/opt/spamassassin (root-owned)
  # for an /opt PREFIX, breaking sa-update writes as the zextras user.
  perl ${_perl_inc} Makefile.PL INSTALL_BASE=/opt/zextras/common \
    DATADIR=/opt/zextras/data/spamassassin/rules \
    CONFDIR=/opt/zextras/data/spamassassin/localrules \
    LOCALSTATEDIR=/opt/zextras/data/spamassassin/state \
    INSTALLSITEMAN1DIR=/opt/zextras/common/share/man/man1 INSTALLSITEMAN3DIR=/opt/zextras/common/share/man/man3 \
    LIB=/opt/zextras/common/lib/perl5
  # build_rules requires rulesrc/ (not in CPAN tarball); no-op the target.
  sed -i 's|^build_rules:.*|build_rules:|; /^build_rules:/{ n; s|.*$(PERL).*mkrules.*||; }' Makefile
  # Pre-create spamc/version.h to avoid version.h.pl pulling Mail::SpamAssassin (NetAddr::IP isn't in system @INC).
  _sa_version=$(perl -ne 'if (/VERSION\s*=\s*"([^"]+)"/) { print $1; exit }' lib/Mail/SpamAssassin.pm)
  sed "s/VERSION_STRING \"3.x\"/VERSION_STRING \"${_sa_version}\"/" \
    spamc/version.h.in > spamc/version.h
  echo '1;' > spamc/version.h.pl

  if [ -n "${CROSS_COMPILE}" ]; then
    # Disable spamc zlib: libz is found but zlib.h is missing for arm64, breaking HAVE_LIBZ/HAVE_ZLIB_H consistency.
    sed -i 's|$(CONFIGURE)|$(CONFIGURE) --host=aarch64-linux-gnu ac_cv_header_zlib_h=no ac_cv_lib_z_deflate=no|' Makefile
  fi
  _jobs=$(($(nproc) / 2)); [ "$_jobs" -lt 1 ] && _jobs=1

  make ${_cc_flag} -j"$_jobs"
}

package() {
  cd "${srcdir}/Mail-SpamAssassin-${pkgver}"
  PERL5LIB="/opt/zextras/common/lib/perl5" \
    make install DESTDIR="${pkgdir}"
  if [ -n "${CROSS_COMPILE}" ] && [ -d "${pkgdir}/opt/zextras/common/lib/perl5/x86_64-linux-gnu-thread-multi" ]; then
    mkdir -p "${pkgdir}/opt/zextras/common/lib/perl5/aarch64-linux-gnu-thread-multi"
    cp -a "${pkgdir}/opt/zextras/common/lib/perl5/x86_64-linux-gnu-thread-multi/." \
      "${pkgdir}/opt/zextras/common/lib/perl5/aarch64-linux-gnu-thread-multi/"
    rm -rf "${pkgdir}/opt/zextras/common/lib/perl5/x86_64-linux-gnu-thread-multi"
  fi
  find "${pkgdir}" -name '.packlist' -delete
  find "${pkgdir}" -name '*.pod' -delete
  rm -rf "${pkgdir}"/opt/zextras/common/data/spamassassin/rules \
    "${pkgdir}"/opt/zextras/data/spamassassin/rules/*

  # Re-ship the SpamAssassin update-signing public key that the rm above strips.
  # sa-update bootstraps its GPG keyring from DEF_RULES_DIR/sa-update-pubkey.txt
  # (here /opt/zextras/data/spamassassin/rules); without it the keyring is empty
  # and every official rule update fails GPG validation (the update is signed by
  # subkey 24F434CE -> "GPG validation failed", sa-update exits 4). The ruleset
  # .cf files are owned by carbonio-spamassassin-rules, which intentionally omits
  # this key, so the engine package must provide it.
  install -Dm644 "${srcdir}/Mail-SpamAssassin-${pkgver}/rules/sa-update-pubkey.txt" \
    "${pkgdir}/opt/zextras/data/spamassassin/rules/sa-update-pubkey.txt"

  if [ -f "${pkgdir}"/opt/zextras/data/spamassassin/localrules/v310.pre ]; then
    sed -i -e 's/^#loadplugin Mail::SpamAssassin::Plugin::DCC/loadplugin Mail::SpamAssassin::Plugin::DCC/' \
      "${pkgdir}"/opt/zextras/data/spamassassin/localrules/v310.pre
  fi
  if [ -f "${pkgdir}"/opt/zextras/data/spamassassin/localrules/v320.pre ]; then
    sed -i -e 's/^#loadplugin Mail::SpamAssassin::Plugin::Rule2XSBody/loadplugin Mail::SpamAssassin::Plugin::Rule2XSBody/' \
      "${pkgdir}"/opt/zextras/data/spamassassin/localrules/v320.pre
  fi

  # systemd tmpfiles.d configuration
  install -Dm644 "${srcdir}/systemd-tmpfile.conf" \
    "${pkgdir}/usr/lib/tmpfiles.d/carbonio-spamassassin.conf"
}

postinst() {
  systemd-tmpfiles --create /usr/lib/tmpfiles.d/carbonio-spamassassin.conf || :

  # Bootstrap (or repair) the sa-update GPG keyring with the trusted SpamAssassin
  # signing key. sa-update only auto-imports the default keyring when trustdb.gpg
  # is absent, so an already-empty/stale keyring on an existing install would
  # never recover on its own; import explicitly so upgrades fix it too. Runs as
  # zextras (the sa-update service user) so the keyring ends up zextras-owned.
  _sa_key="/opt/zextras/data/spamassassin/rules/sa-update-pubkey.txt"
  _sa_keyring="/opt/zextras/data/spamassassin/localrules/sa-update-keys"
  if command -v gpg >/dev/null 2>&1 && [ -f "${_sa_key}" ] && getent passwd zextras >/dev/null; then
    install -d -o zextras -g zextras -m 0700 "${_sa_keyring}"
    runuser -u zextras -- /opt/zextras/common/bin/sa-update \
      --import "${_sa_key}" --gpghomedir "${_sa_keyring}" >/dev/null 2>&1 || :
  fi
}
