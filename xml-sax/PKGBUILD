pkgname="carbonio-perl-xml-sax"
pkgver="1.02" # renovate: datasource=cpan depName=XML::SAX
pkgrel="4"
pkgdesc="Simple API for XML"
arch=('any')
maintainer="Zextras <packages@zextras.com>"
url="https://github.com/zextras"
license=('Artistic-1.0-Perl OR GPL-1.0-or-later')
depends__apt=(
  "carbonio-perl-xml-namespacesupport"
  "carbonio-perl-xml-sax-base"
  "perl"
)
depends__yum=(
  "carbonio-perl-xml-namespacesupport"
  "carbonio-perl-xml-sax-base"
  "perl-core"
  "perl"
)
section="libs"
priority="important"
source=(
  "https://cpan.metacpan.org/authors/id/G/GR/GRANTM/XML-SAX-${pkgver}.tar.gz"
)
sha256sums=('4506c387043aa6a77b455f00f57409f3720aa7e553495ab2535263b4ed1ea12a')

build() {
  cd "${srcdir}/XML-SAX-${pkgver}"
  perl -I /opt/zextras/common/lib/perl5 Makefile.PL INSTALL_BASE=/opt/zextras/common \
    INSTALLSITEMAN1DIR=/opt/zextras/common/share/man/man1 INSTALLSITEMAN3DIR=/opt/zextras/common/share/man/man3 \
    LIB=/opt/zextras/common/lib/perl5
  make
}

package() {
  cd "${srcdir}/XML-SAX-${pkgver}"
  PERL5LIB=/opt/zextras/common/lib/perl5:${pkgdir}/opt/zextras/common/lib/perl5 \
    make install DESTDIR="${pkgdir}"
  find "${pkgdir}" -name '.packlist' -delete
  find "${pkgdir}" -name '*.pod' -delete

  # ParserDetails.ini is not created by 'make install' under DESTDIR; register
  # the bundled PurePerl parser so XML::SAX does not warn about a missing file.
  # The staged XML/SAX.pm must come first in @INC: save_parsers() writes next to
  # the copy of SAX.pm that was loaded.
  PERL5LIB=${pkgdir}/opt/zextras/common/lib/perl5:/opt/zextras/common/lib/perl5 \
    perl -MXML::SAX -e 'XML::SAX->add_parser(q(XML::SAX::PurePerl))->save_parsers()'
  test -s "${pkgdir}/opt/zextras/common/lib/perl5/XML/SAX/ParserDetails.ini"
}

# Re-register the Expat driver (shipped by carbonio-perl-xml-sax-expat) when
# this package is upgraded, since the upgrade rewrites ParserDetails.ini.
postinst() {
  if [ -f /opt/zextras/common/lib/perl5/XML/SAX/Expat.pm ]; then
    perl -I/opt/zextras/common/lib/perl5 -MXML::SAX \
      -e 'XML::SAX->add_parser(q(XML::SAX::Expat))->save_parsers()' || :
  fi
}
