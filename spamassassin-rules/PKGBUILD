_revision="r1928015"
pkgname="carbonio-spamassassin-rules"
pkgver="4.0.2"
pkgrel="2"
pkgdesc="Default ruleset for SpamAssassin"
arch=('any')
maintainer="Zextras <packages@zextras.com>"
url="https://github.com/zextras"
license=('Apache-2.0')
depends__apt=(
  "carbonio-perl-mail-spamassassin"
  "perl"
)
depends__yum=(
  "carbonio-perl-mail-spamassassin"
  "perl"
  "perl-core"
)
section="libs"
priority="important"

# Official Apache SpamAssassin ruleset, pinned to the engine release.
# Shipped as a source tarball instead of a build-time `sa-update` fetch: sa-update
# is not guaranteed to be present in the build image (and needs network), which
# silently produced EMPTY packages -> amavisd "no rules were found" Suicide.
# Bump this revision together with carbonio-perl-mail-spamassassin (pkgver).
# https://archive.apache.org/dist/spamassassin/source/
source=(
  "https://archive.apache.org/dist/spamassassin/source/Mail-SpamAssassin-rules-${pkgver}.${_revision}.tgz"
)
sha256sums=(
  'f82128687117113dbe40bdc4e3141b87f96c2b01519c9022597da47e726a613e'
)

package() {
  _rulesdir="${pkgdir}/opt/zextras/data/spamassassin/rules"
  install -d "${_rulesdir}"

  # The tarball extracts into ${srcdir} (flat): *.cf rule files, the TextCat
  # "languages" data file, and sa-update-pubkey.txt (sa-update's signing key).
  # Copy via find so it works regardless of whether yap extracts flat or into a
  # subdir. Skip user_prefs.template and the STATISTICS-*.cf.txt score reports.
  find "${srcdir}" -maxdepth 2 -type f -name '*.cf' \
    -exec install -m644 {} "${_rulesdir}/" \;
  _lang=$(find "${srcdir}" -maxdepth 2 -type f -name languages | head -n1)
  if [ -n "${_lang}" ]; then
    install -m644 "${_lang}" "${_rulesdir}/"
  fi

  # Ship sa-update's signing public key in DEF_RULES_DIR. sa-update bootstraps its
  # GPG keyring from <DEF_RULES_DIR>/sa-update-pubkey.txt (the engine postinst then
  # imports it); without it the keyring is empty and every official rule update
  # fails GPG validation (signed by subkey 24F434CE -> sa-update exit 4). This path
  # historically belonged to this package (the old sa-update build flow shipped it),
  # so it must stay here: carbonio-perl-mail-spamassassin must NOT also ship it, or
  # dpkg hits a file-overwrite conflict on upgrade against the installed
  # carbonio-spamassassin-rules that still owns this path.
  _pubkey=$(find "${srcdir}" -maxdepth 2 -type f -name sa-update-pubkey.txt | head -n1)
  if [ -z "${_pubkey}" ]; then
    echo "ERROR: sa-update-pubkey.txt not found in source tarball; refusing to ship a keyless ruleset" >&2
    exit 1
  fi
  install -m644 "${_pubkey}" "${_rulesdir}/sa-update-pubkey.txt"

  # Never publish an empty ruleset (the engine reads these from
  # DEF_RULES_DIR=/opt/zextras/data/spamassassin/rules).
  _count=$(find "${_rulesdir}" -maxdepth 1 -name '*.cf' | wc -l)
  if [ "${_count}" -eq 0 ]; then
    echo "ERROR: no .cf rule files found in source tarball; refusing to build an empty package" >&2
    exit 1
  fi
  echo "Packaged ${_count} SpamAssassin rule file(s)"
}
